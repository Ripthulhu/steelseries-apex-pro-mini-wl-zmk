+#endif
 
 #include <zephyr/logging/log.h>
 
@@ -78,6 +82,7 @@ bool zmk_endpoint_instance_eq(struct zmk_endpoint_instance a, struct zmk_endpoin
     switch (a.transport) {
     case ZMK_TRANSPORT_NONE:
     case ZMK_TRANSPORT_USB:
+    case ZMK_TRANSPORT_RADIO:
         return true;
 
     case ZMK_TRANSPORT_BLE:
@@ -95,6 +100,8 @@ int zmk_endpoint_instance_to_str(struct zmk_endpoint_instance endpoint, char *st
 
     case ZMK_TRANSPORT_USB:
         return snprintf(str, len, "USB");
+    case ZMK_TRANSPORT_RADIO:
+        return snprintf(str, len, "Radio");
 
     case ZMK_TRANSPORT_BLE:
         return snprintf(str, len, "BLE:%d", endpoint.ble.profile_index);
@@ -118,6 +125,8 @@ int zmk_endpoint_instance_to_index(struct zmk_endpoint_instance endpoint) {
 
     case ZMK_TRANSPORT_BLE:
         return INSTANCE_INDEX_OFFSET_BLE + endpoint.ble.profile_index;
+    case ZMK_TRANSPORT_RADIO:
+        return INSTANCE_INDEX_OFFSET_BLE + ZMK_ENDPOINT_BLE_COUNT;
     }
 
     LOG_ERR("Invalid transport %d", endpoint.transport);
@@ -171,10 +180,22 @@ struct zmk_endpoint_instance zmk_endpoint_get_preferred(void) {
 
 struct zmk_endpoint_instance zmk_endpoint_get_selected(void) { return current_instance; }
 
-bool zmk_endpoint_is_connected(void) { return current_instance.transport != ZMK_TRANSPORT_NONE; }
+bool zmk_endpoint_is_connected(void) {
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+    if (current_instance.transport == ZMK_TRANSPORT_RADIO) return apex_radio_input_connected();
+#endif
+    return current_instance.transport != ZMK_TRANSPORT_NONE;
+}
 
 static int send_keyboard_report(void) {
     switch (current_instance.transport) {
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+    case ZMK_TRANSPORT_RADIO: {
+        struct zmk_hid_keyboard_report *r = zmk_hid_get_keyboard_report();
+        BUILD_ASSERT(sizeof(r->body) == APEX_INPUT_KEYBOARD_SIZE);
+        return apex_radio_queue_report(APEX_INPUT_KEYBOARD, (const uint8_t *)&r->body, sizeof(r->body));
+    }
+#endif
     case ZMK_TRANSPORT_NONE:
         return 0;
 
@@ -212,6 +233,13 @@ static int send_keyboard_report(void) {
 
 static int send_consumer_report(void) {
     switch (current_instance.transport) {
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+    case ZMK_TRANSPORT_RADIO: {
+        struct zmk_hid_consumer_report *r = zmk_hid_get_consumer_report();
+        BUILD_ASSERT(sizeof(r->body) == APEX_INPUT_CONSUMER_SIZE);
+        return apex_radio_queue_report(APEX_INPUT_CONSUMER, (const uint8_t *)&r->body, sizeof(r->body));
+    }
+#endif
     case ZMK_TRANSPORT_NONE:
         return 0;
 
@@ -422,6 +450,11 @@ static bool is_ble_ready(void) {
 }
 
 static enum zmk_transport get_selected_transport(void) {
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+    /* The physical switch chooses radio ownership. A configured USB HID host
+     * takes priority; VBUS from a charger alone does not select USB. */
+    if (g4b_mode_boot_dongle()) return is_usb_ready() ? ZMK_TRANSPORT_USB : ZMK_TRANSPORT_RADIO;
+#endif
     switch (preferred_transport) {
     case ZMK_TRANSPORT_NONE:
         LOG_DBG("No endpoint transport selected");
@@ -464,6 +497,9 @@ static int zmk_endpoints_init(void) {
 #endif
 
     current_instance = get_selected_instance();
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+    apex_radio_input_select(current_instance.transport == ZMK_TRANSPORT_RADIO);
+#endif
 
     return 0;
 }
@@ -487,6 +523,9 @@ static void update_current_endpoint(void) {
         zmk_endpoint_clear_reports();
 
         current_instance = new_instance;
+#if IS_ENABLED(CONFIG_APEX_G4B_RADIO_INPUT)
+        apex_radio_input_select(current_instance.transport == ZMK_TRANSPORT_RADIO);
+#endif
 
         char endpoint_str[ZMK_ENDPOINT_STR_LEN];
         zmk_endpoint_instance_to_str(current_instance, endpoint_str, sizeof(endpoint_str));
