+    err = usbd_add_descriptor(&zmk_usbd, &zmk_usbd_lang);    if (err) goto fail;
+    err = usbd_add_descriptor(&zmk_usbd, &zmk_usbd_mfr);     if (err) goto fail;
+    err = usbd_add_descriptor(&zmk_usbd, &zmk_usbd_product); if (err) goto fail;
+    err = usbd_add_descriptor(&zmk_usbd, &zmk_usbd_sn);      if (err) goto fail;
+
+    err = usbd_add_configuration(&zmk_usbd, USBD_SPEED_FS, &zmk_usbd_fs_config);
+    if (err) goto fail;
