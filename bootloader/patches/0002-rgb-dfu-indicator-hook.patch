+  } else if ( state == STATE_WRITING_FINISHED ) {
+    extern void board_rgb_dfu(uint32_t rgb);
+    board_rgb_dfu(0x00FF00u);                /* success: whole board green */
+  } else if ( state == STATE_USB_UNMOUNTED ) {
+    extern void board_rgb_dfu(uint32_t rgb);
+    board_rgb_dfu(0x000000u);                /* drive ejected: go dark */
+  }
+#endif
