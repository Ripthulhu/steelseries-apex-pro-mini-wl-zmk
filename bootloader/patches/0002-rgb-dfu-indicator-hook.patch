+#ifdef BOARD_HAS_RGB_DFU
+  /* Apex: mirror the DFU state onto the per-key RGB matrix (the only visible LED
+   * on this board). Restricted to the states that mean "actually in DFU" so a
+   * normal boot - which fires STATE_BOOTLOADER_STARTED then jumps to the app -
+   * stays dark. green = DFU drive mounted, red = writing / unmounted. */
+  if ( state == STATE_USB_MOUNTED || state == STATE_WRITING_STARTED ||
+       state == STATE_WRITING_FINISHED || state == STATE_USB_UNMOUNTED )
+  {
+    extern void board_rgb_dfu(uint32_t rgb);
+    board_rgb_dfu( (temp_color != 0) ? temp_color : rgb_color );
+  }
+#endif
