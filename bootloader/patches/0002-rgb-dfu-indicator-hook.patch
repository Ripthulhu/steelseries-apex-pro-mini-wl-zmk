+#ifdef BOARD_HAS_RGB_DFU
+  /* Apex: mirror the DFU state onto the per-key RGB matrix (the only visible LED
+   * on this board). Idle shows a breathing red field with the D/F/U keys green;
+   * the red left->right write bar is driven from the UF2 write path (ghostfat.c),
