#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/apex_actuation.h>

/ {
    combos {
        compatible = "zmk,combos";

        /* Enter the Adafruit bootloader (UF2/serial DFU): hold Fn (layer 1)
         * and press Escape + Right-Ctrl together. A three-key, layer-gated
         * combo so it cannot be hit by accident. Key positions: ESC = 0,
         * Right-Ctrl = 60 (last key of the bottom row). */
        combo_bootloader {
            /* Allow 250 ms between the two presses. A key released before the
             * combo completes is emitted as a normal tap, so the window does not
             * delay a quick Fn+Esc (= GRAVE). */
            timeout-ms = <250>;
            key-positions = <0 60>;
            layers = <1>;
            bindings = <&apex_dfu>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Both Fn positions are momentary layer keys. The Caps Lock position
         * never sends Caps Lock, whether tapped or held. */
        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH
&mo 1      &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT              &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH              &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT                         &kp SPACE                                  &kp RALT  &kp RGUI  &mo 1      &kp RCTRL
            >;
        };

        /* The Fn layer follows the printed legends where ZMK has an equivalent.
         * Q adjusts release sensitivity, Z toggles the optional USB gamepad,
         * and X cycles the custom lighting effects. See docs/KEYMAP.md. */
        function_layer {
            display-name = "Fn";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &kp DEL
&trans     &actuation ACT_RESET &kp UP &rgb_ug RGB_TOG &rgb_ug RGB_EFR &actuation ACT_RT_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &actuation ACT_SHALLOW &actuation ACT_DEEPER &kp PSCRN &kp HOME &kp PG_UP &bt BT_CLR
&trans     &kp LEFT &kp DOWN &kp RIGHT &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp INS &kp END &kp PG_DN     &trans
&trans     &analog_tog &actuation ACT_FX_NEXT &rgb_ug RGB_BRD &rgb_ug RGB_BRI &kp C_VOL_DN &kp C_VOL_UP &kp C_MUTE &kp C_PREV &kp C_NEXT &kp C_PP      &trans
&trans     &trans   &trans                          &trans                                     &trans     &trans   &trans     &trans
            >;
        };
    };
};
