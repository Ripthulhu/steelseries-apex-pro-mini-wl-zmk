/dts-v1/;
#include <nordic/nrf52833_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <layouts/common/60percent/ansi.dtsi>
#include "apex_pro_mini_wl-pinctrl.dtsi"

/ {
    model = "SteelSeries Apex Pro Mini Wireless";
    compatible = "steelseries,apex-pro-mini-wl";

    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,code-partition = &code_partition;
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_60_ansi;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12)     RC(0,13)
RC(1,0)   RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)   RC(1,13)
RC(2,0)     RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)          RC(2,13)
RC(3,0)       RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)    RC(3,10)              RC(3,13)
RC(4,0)   RC(4,1)   RC(4,2)                      RC(4,5)                       RC(4,9)   RC(4,10)   RC(4,11)   RC(4,13)
        >;
    };

    kscan0: kscan {
        compatible = "steelseries,apex-stm32-kscan";
        rows = <5>;
        columns = <14>;
    };
};

&layout_60_ansi {
    transform = <&default_transform>;
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

/*
 * Full 128 KiB SRAM. The old 0x20000000-0x20002fff (12 KiB) reservation was the
 * Nordic S113/s140 SoftDevice's RAM contract - reclaimed now that the SD is gone
 * (see docs/FLASH_MEMORY_MAP.md). Safe: the app relocates its vector table (VTOR
 * -> 0x1000, CONFIG_CPU_CORTEX_M_HAS_VTOR) so the MBR's IRQ-forwarding is
 * bypassed and needs no app RAM, and the Adafruit double-reset magic lives at
 * 0x20007F7C (untouched by this change; double-tap works on boot-window timing).
 */
&sram0 {
    reg = <0x20000000 0x00020000>;
};

/*
 * Stock firmware uses SPIM3 at 0x4002f000 with SCK P0.4, MOSI P0.6 and
 * MISO P0.7. It configures no hardware chip select. P0.2/P1.5 are driven
 * among the unresolved manual control signals. P0.24 signals a queued STM32
 * A1 event. The peripheral remains disabled until the transport driver is
 * enabled.
 */
&spi3 {
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&apex_stm32_spi_default>;
    pinctrl-1 = <&apex_stm32_spi_sleep>;
    pinctrl-names = "default", "sleep";
    overrun-character = <0>;
    status = "disabled";
};

zephyr_udc0: &usbd {
    /* The physical USB connector terminates at the stock STM32. */
    status = "disabled";
};

/*
 * Current Adafruit nRF52 bootloader layout (nRF52833, 512 KiB). The stock
 * loader and s140 are gone; the application uses Zephyr's controller and starts
 * immediately above the retained MBR. See docs/FLASH_MEMORY_MAP.md.
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /* MBR only (0x0-0x1000). The s140 SoftDevice that used to sit at
         * 0x1000-0x27000 is GONE: ZMK uses Zephyr's own BLE controller and never
         * enabled the SD, and the Adafruit bootloader launches the app at
         * MBR_SIZE (0x1000) when no SD is present (is_sd_existed()==false). This
         * reclaims ~152 KiB - see docs/FLASH_MEMORY_MAP.md. */
        mbr_partition: partition@0 {
            reg = <0x00000000 0x00001000>;
        };

        /* Application slot, now right above the MBR. zephyr,code-partition ->
         * CONFIG_FLASH_LOAD_OFFSET derives 0x1000 (CONFIG_USE_DT_CODE_PARTITION). */
        code_partition: partition@1000 {
            label = "image-0";
            reg = <0x00001000 0x00071000>;
        };

        /* ZMK settings (bonds, RGB state, etc.). */
        storage_partition: partition@72000 {
            label = "storage";
            reg = <0x00072000 0x00002000>;
        };

        /* Adafruit bootloader (0x74000-0x7E000). MBR-params (0x7E000) and
         * bootloader-settings (0x7F000) are owned by the bootloader. */
        boot_partition: partition@74000 {
            reg = <0x00074000 0x0000A000>;
        };
    };
};

/ {
    behaviors {
        /* Toggles the analog gamepad axis. Declared here rather than in the
         * G4B overlay because the keymap is shared by every stage image, and a
         * behavior a shared keymap references has to resolve in all of them.
         * src/behavior_analog_g4b.c is compiled for every build of this board
         * for the same reason, falling back to stubs when the gamepad is off.
         */
        /* Reboot into the Adafruit bootloader (UF2/serial DFU). Bound via a
         * combo to Fn+Esc+RCtrl in the keymap. Declared here (like the others)
         * because the keymap is shared by every stage image. */
        apex_dfu: behavior_dfu {
            compatible = "apex,behavior-dfu";
            #binding-cells = <0>;
            display-name = "Bootloader (DFU)";
        };

        analog_tog: behavior_analog_toggle {
            compatible = "apex,behavior-analog-toggle";
            #binding-cells = <0>;
            /* What ZMK Studio shows. Without it the node renders as its raw
             * devicetree name, which tells a user nothing.
             */
            display-name = "Game Mode";
        };

        /* Actuation point, reset point and rapid trigger, from the keymap.
         *
         * One behavior with a parameter rather than five compatibles - they are
         * one control surface, and each devicetree behavior costs real space.
         * Parameter values are in dt-bindings/apex_actuation.h; the keymap
         * should use the ACT_* macros rather than bare numbers, because a
         * mismatch binds the wrong action with no error anywhere.
         */
        actuation: behavior_actuation {
            compatible = "apex,behavior-actuation";
            #binding-cells = <1>;
            display-name = "Actuation & Rapid Trigger";
        };
    };
};
